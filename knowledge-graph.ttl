# BRAIN BBQS Knowledge Graph
# Edit this file to add nodes and relationships.
# ──────────────────────────────────────────────────────────────────────────────

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix ex:     <https://brain-bbqs.org/vocab/> .
@prefix bbqs:   <https://brain-bbqs.org/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .


# ── Consortium ────────────────────────────────────────────────────────────────

bbqs:BBQS a ex:Consortium ;
    schema:name             "BRAIN BBQS" ;
    schema:description      "BRAIN Behavior Quantification and Synchronization consortium" ;
    schema:url              <https://brain-bbqs.org/> ;
    schema:foundingDate     "2022"^^xsd:gYear ;
    schema:funder           <https://www.nih.gov/> ;
    schema:sameAs           <https://reporter.nih.gov/project-details/PLACEHOLDER> ;
    schema:contactPoint     <mailto:contact@brain-bbqs.org> ;
    schema:keywords         "behavior, neuroscience, quantification, synchronization, standardization" .


# ── Working Groups ────────────────────────────────────────────────────────────

bbqs:wg-analytics a ex:WorkingGroup ;
    schema:name             "WG-Analytics" ;
    schema:parentOrganization bbqs:BBQS ;
    schema:description      "Developing shared analytical frameworks, pipelines, and computational methods for cross-project neural data analysis." .

bbqs:wg-devices a ex:WorkingGroup ;
    schema:name             "WG-Devices" ;
    schema:parentOrganization bbqs:BBQS ;
    schema:description      "Compiling best practices for multimodal data acquisition, device integration, calibration, and synchronization across laboratories." .

bbqs:wg-elsi a ex:WorkingGroup ;
    schema:name             "WG-ELSI" ;
    schema:parentOrganization bbqs:BBQS ;
    schema:description      "Addressing ethical, legal, and social implications of brain research, ensuring responsible innovation and data governance." .

bbqs:wg-standards a ex:WorkingGroup ;
    schema:name             "WG-Standards" ;
    schema:parentOrganization bbqs:BBQS ;
    schema:description      "Establishing and promoting adoption of data standards for novel sensors and multimodal data integration to facilitate FAIR sharing." .



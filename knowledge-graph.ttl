# ── Products ──────────────────────────────────────────────────────────────────

bbqs:prod-openfield a ex:Product, schema:SoftwareApplication ;
    schema:name             "OpenField Tracker" ;
    schema:description      "Open-source tracking software for open-field behavioral assays" ;
    schema:softwareVersion  "0.1.0" ;
    schema:codeRepository   <https://github.com/brain-bbqs/openfield-tracker> ;
    schema:license          <https://opensource.org/licenses/MIT> ;
    schema:programmingLanguage "Python" ;
    schema:isPartOf         bbqs:wg-standards .

bbqs:prod-arena a ex:Product, schema:Product ;
    schema:name             "Standardized Arena Kit" ;
    schema:description      "Hardware kit for reproducible open-field behavioral experiments" ;
    schema:manufacturer     bbqs:BBQS ;
    schema:isPartOf         bbqs:wg-devices .

bbqs:prod-pose-model a ex:Product, schema:SoftwareApplication ;
    schema:name             "BBQS Pose Model v1" ;
    schema:description      "Pretrained pose estimation model for rodent behavior" ;
    schema:softwareVersion  "1.0.0" ;
    schema:codeRepository   <https://github.com/brain-bbqs/pose-model> ;
    schema:applicationCategory "Machine Learning" ;
    schema:isPartOf         bbqs:wg-analytics .

bbqs:prod-behavior-algo a ex:Product, schema:SoftwareApplication ;
    schema:name             "Behavior Segmentation Algorithm" ;
    schema:description      "Unsupervised algorithm for segmenting continuous behavior streams" ;
    schema:codeRepository   <https://github.com/brain-bbqs/behavior-segmentation> ;
    schema:programmingLanguage "Python" ;
    schema:isPartOf         bbqs:wg-analytics .

bbqs:prod-rodent-dataset a ex:Product, schema:Dataset ;
    schema:name             "Rodent Behavior Dataset 2025" ;
    schema:description      "Annotated multi-species rodent behavior video dataset" ;
    schema:datePublished    "2025-01-01"^^xsd:date ;
    schema:license          <https://creativecommons.org/licenses/by/4.0/> ;
    schema:measurementTechnique "Video tracking, pose estimation" ;
    schema:variableMeasured "locomotion, grooming, rearing, social interaction" ;
    schema:identifier       "PLACEHOLDER-DOI" ;
    schema:isPartOf         bbqs:project-species .

# ── Observable Properties (SOSA) ──────────────────────────────────────────────
# Shared measurement phenomena; multiple sensors may observe the same property.

bbqs:prop-video a sosa:ObservableProperty ;
    schema:name        "Video" ;
    schema:description "Visual recording of behavior and environment" .

bbqs:prop-body-position a sosa:ObservableProperty ;
    schema:name        "Body position / posture" ;
    schema:description "2-D or 3-D body position, pose, and postural kinematics" .

bbqs:prop-gaze a sosa:ObservableProperty ;
    schema:name        "Gaze and pupil" ;
    schema:description "Gaze direction, pupil size, fixations, and saccades" .

bbqs:prop-eda a sosa:ObservableProperty ;
    schema:name        "Electrodermal activity" ;
    schema:description "Skin conductance / galvanic skin response reflecting arousal" .

bbqs:prop-respiration a sosa:ObservableProperty ;
    schema:name        "Respiration" ;
    schema:description "Breathing rhythm, airflow, and respiratory effort" .

bbqs:prop-audio-bioacoustic a sosa:ObservableProperty ;
    schema:name        "Bioacoustic audio" ;
    schema:description "Passive acoustic monitoring of vocalizations and environmental sounds" .

bbqs:prop-audio-ultrasonic a sosa:ObservableProperty ;
    schema:name        "Ultrasonic vocalizations" ;
    schema:description "Ultrasonic vocalizations up to ~250 kHz" .

bbqs:prop-audio-localization a sosa:ObservableProperty ;
    schema:name        "Acoustic source localization" ;
    schema:description "Multi-microphone direction-of-arrival and source localization" .

bbqs:prop-location-gps a sosa:ObservableProperty ;
    schema:name        "GPS location" ;
    schema:description "Geographic position and ranging via GPS" .

bbqs:prop-3d-kinematics a sosa:ObservableProperty ;
    schema:name        "3-D kinematics" ;
    schema:description "Whole-body 3-D joint angles and kinematic trajectories" .

bbqs:prop-imu a sosa:ObservableProperty ;
    schema:name        "Inertial motion" ;
    schema:description "Accelerometry, gyroscopy, and IMU-derived motion" .

bbqs:prop-neural-eeg a sosa:ObservableProperty ;
    schema:name        "EEG" ;
    schema:description "Surface electroencephalography" .

bbqs:prop-neural-ieeg a sosa:ObservableProperty ;
    schema:name        "Intracranial EEG / LFP" ;
    schema:description "iEEG, ECoG, and local field potentials" .

bbqs:prop-neural-single-unit a sosa:ObservableProperty ;
    schema:name        "Single-unit spiking" ;
    schema:description "Action potentials from individual neurons" .

bbqs:prop-neural-meg a sosa:ObservableProperty ;
    schema:name        "MEG" ;
    schema:description "Magnetoencephalography" .

bbqs:prop-neural-emg a sosa:ObservableProperty ;
    schema:name        "EMG" ;
    schema:description "Surface or intramuscular electromyography" .

bbqs:prop-neural-nirs a sosa:ObservableProperty ;
    schema:name        "fNIRS" ;
    schema:description "Functional near-infrared spectroscopy for hemodynamic response" .

bbqs:prop-heart-rate a sosa:ObservableProperty ;
    schema:name        "Heart rate / ECG / PPG" ;
    schema:description "Cardiac rhythm via ECG electrodes or PPG optical sensor" .

bbqs:prop-temperature a sosa:ObservableProperty ;
    schema:name        "Body temperature" ;
    schema:description "Core or skin temperature" .

bbqs:prop-rfid-id a sosa:ObservableProperty ;
    schema:name        "RFID animal ID" ;
    schema:description "Passive integrated transponder individual identification" .

bbqs:prop-operant-behavior a sosa:ObservableProperty ;
    schema:name        "Operant / cognitive behavior" ;
    schema:description "Touch-screen or button responses in cognitive and operant tasks" .

bbqs:prop-biochemical a sosa:ObservableProperty ;
    schema:name        "Biochemical markers" ;
    schema:description "Cortisol, glucose, melatonin, epinephrine assays" .

bbqs:prop-egocentric-video a sosa:ObservableProperty ;
    schema:name        "Egocentric video" ;
    schema:description "First-person point-of-view video for visual sensorium" .


# ── Sensor Registry — WG-Devices Workshop 2026 ───────────────────────────────
# Source: unstructured_data/working_groups/wg_devices/sensor_device_registry_workshop_2026.pdf
# All sensors use SOSA ontology (http://www.w3.org/ns/sosa/).
# ex:institution = submitting institution; schema:manufacturer = device maker (HQ).

# ── Mount Sinai — Grinband lab ────────────────────────────────────────────────

bbqs:sensor-obsbot-tiny2 a sosa:Sensor ;
    schema:name         "OBSBOT Tiny 2 AI PTZ 4K" ;
    schema:manufacturer "OBSBOT, Shenzhen, China" ;
    schema:description  "AI-tracked pan-tilt-zoom 4K webcam for overhead behavioral video" ;
    sosa:observes       bbqs:prop-video, bbqs:prop-body-position ;
    ex:institution      "Mount Sinai" ;
    schema:isPartOf     bbqs:wg-devices .

bbqs:sensor-tobii-pro-spectrum a sosa:Sensor ;
    schema:name         "Tobii Pro Spectrum (to 1200 Hz)" ;
    schema:manufacturer "Tobii AB, Danderyd, Sweden" ;
    schema:description  "High-frequency screen-based eye tracker for gaze and pupillometry" ;
    sosa:observes       bbqs:prop-gaze ;
    ex:institution      "Mount Sinai" ;
    schema:isPartOf     bbqs:wg-devices .

bbqs:sensor-biopac-pleth-eda a sosa:Sensor ;
    schema:name         "BIOPAC SS5LB + Shimmer3 GSR+" ;
    schema:manufacturer "BIOPAC Systems, Goleta CA; Shimmer Research, Dublin" ;
    schema:description  "Plethysmograph for respiratory effort combined with EDA recording" ;
    sosa:observes       bbqs:prop-respiration, bbqs:prop-eda ;
    ex:institution      "Mount Sinai" ;
    schema:isPartOf     bbqs:wg-devices .

